# Copy this file to .env.local and replace the placeholders with values from
# your own Supabase project (Supabase dashboard: Project Settings -> API).
# Never commit .env.local or any file containing real keys.

# Supabase project URL. Public: exposed to the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key. Public: exposed to the browser; every query it
# makes is limited by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. SERVER-ONLY: bypasses row-level security. Read only
# by src/lib/supabase/admin.ts, which is used in server code (admin-gated
# actions, and the public assessment / FMS booking actions after validation).
# Never give it a NEXT_PUBLIC_ prefix and never import it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
